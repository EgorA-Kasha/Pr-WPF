<Page x:Class="Pr_WPF.ZakaZ"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr_WPF"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ZakaZ">

    <Grid>
        <ScrollViewer>
            <StackPanel Margin="20">
                <TextBlock Text="Оформление заказа" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       Margin="0,0,0,20"/>

                <TextBlock Text="ФИО:"/>
                <TextBox x:Name="txtFullName" Height="25" Margin="0,5,0,10"/>

                <TextBlock Text="Email:"/>
                <TextBox x:Name="txtEmail" Height="25" Margin="0,5,0,10"/>

                <TextBlock Text="Адрес доставки:"/>
                <TextBox x:Name="txtAddress" Height="60" Margin="0,5,0,20" AcceptsReturn="True"/>

                <TextBlock x:Name="OrderSummaryText" 
                       Margin="0,0,0,20" 
                       TextWrapping="Wrap"/>

                <Button Content="Заказать" 
                    Width="150" 
                    Height="30"
                    /><!--Click="OrderButton_Click"-->
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
