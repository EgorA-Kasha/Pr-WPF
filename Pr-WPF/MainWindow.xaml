<Window x:Class="CarConfigurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Конфигуратор вашего ведра с болтами" 
        Width="800" 
        Height="600" 
        MinWidth="700" 
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Window.Resources>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка с ProgressBar -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="20">
            <StackPanel>
                <TextBlock Text="Конфигуратор автомобиля" 
                           Foreground="White" 
                           FontSize="28" 
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                <ProgressBar Value="{Binding CurrentStep}" 
                           Maximum="5" 
                           Height="20" 
                           Margin="0,20,0,0"
                           Foreground="#4CAF50"/>

                <TextBlock Text="{Binding StepTitle}" 
                           Foreground="White" 
                           FontSize="16" 
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- Контент страницы -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}"/>

        <!-- Нижняя панель с кнопками -->
        <Border Grid.Row="2" Background="#34495E" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="* - обязательные для заполнения поля" 
                           Foreground="#CCCCCC" 
                           FontSize="12"
                           VerticalAlignment="Center"
                           Grid.Column="0"/>

                <Button x:Name="btnBack" 
                        Content="Назад" 
                        Background="#f0f0f0"
                        Padding="20,10"
                        FontSize="14"
                        Margin="5"
                        MinWidth="100"
                        Click="btnBack_Click"
                        Grid.Column="1"
                        IsEnabled="{Binding CanGoBack}"/>

                <Button x:Name="btnNext" 
                        Content="{Binding NextButtonText}" 
                        Background="#4CAF50"
                        Foreground="White"
                        Padding="20,10"
                        FontSize="14"
                        Margin="20,5,5,5"
                        MinWidth="100"
                        Click="btnNext_Click"
                        Grid.Column="2"
                        IsEnabled="{Binding CanGoNext}"/>
            </Grid>
        </Border>
    </Grid>
</Window>