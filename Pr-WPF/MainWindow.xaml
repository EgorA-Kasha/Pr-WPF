<Window x:Class="Pr_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="МемКИП магазин" Height="600" Width="800">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Orientation="Horizontal" Background="LightGray">
			<Button x:Name="btnProducts" Content="Товары" Width="100" Height="30" Margin="5" Click="BtnProduct_Click" /><!---->
			<Button x:Name="btnCart" Content="Корзина" Width="100" Height="30" Margin="5" Click="BtnCart_Click"/><!---->
			<Button x:Name="btnOrder" Content="Оформить заказ" Width="100" Height="30" Margin="5" Click="BtnOrder_Click"/><!---->
		</StackPanel>

		<Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>
	</Grid>
</Window>