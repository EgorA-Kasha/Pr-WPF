<UserControl x:Class="CarConfigurator.Step5Page"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- заголовок -->
            <TextBlock Text="Оформление заявки" 
                       FontSize="16" FontWeight="SemiBold" 
                       Margin="0,0,0,10"/>

            <!-- контактные данные -->
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="Имя*" 
                           FontSize="14" Margin="0,10,0,5"/>

                <TextBox x:Name="nameBox"
                         FontSize="14" Padding="10,5"
                         Margin="0,5,0,15" MinWidth="200"
                         BorderBrush="Gray"/>

                <TextBlock Text="Телефон* (формат: +7XXXXXXXXXX)" 
                           FontSize="14" Margin="0,10,0,5"/>

                <TextBox x:Name="phoneBox"
                         FontSize="14" Padding="10,5"
                         Margin="0,5,0,15" MinWidth="200"
                         BorderBrush="Gray"/>

                <TextBlock Text="Email*" 
                           FontSize="14" Margin="0,10,0,5"/>

                <TextBox x:Name="emailBox"
                         FontSize="14" Padding="10,5"
                         Margin="0,5,0,15" MinWidth="200"
                         BorderBrush="Gray"/>
            </StackPanel>

            <!-- краткая сводка -->
            <Border Background="WhiteSmoke" Padding="15" Margin="0,30,0,0">
                <StackPanel>
                    <!-- заголовок сводки -->
                    <TextBlock Text="Итоговая конфигурация"
                               FontWeight="Bold" FontSize="16" 
                               Margin="0,0,0,10"/>

                    <!-- модель и двигатель -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Модель и двигатель:" 
                                   FontWeight="Bold" Width="180"/>
                        <TextBlock x:Name="modelEngineText"/>
                    </StackPanel>

                    <!-- цвет -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Цвет:" 
                                   FontWeight="Bold" Width="180"/>
                        <TextBlock x:Name="colorSummaryText"/>
                    </StackPanel>

                    <!-- опции -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Опции:" 
                                   FontWeight="Bold" Width="180"/>
                        <TextBlock x:Name="optionsSummaryText"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- разделитель -->
                    <Separator x:Name="summarySeparator" 
                               Margin="0,10,0,10"/>

                    <!-- итоговая стоимость -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Итоговая стоимость:" 
                                   FontWeight="Bold" Width="180"/>
                        <TextBlock x:Name="finalPriceText"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="DarkGreen"/>
                    </StackPanel>

                    <!-- ежемесячный платеж -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Ежемесячный платёж:" 
                                   FontWeight="Bold" Width="180"/>
                        <TextBlock x:Name="monthlyPaymentSummaryText"
                                   FontSize="14"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>