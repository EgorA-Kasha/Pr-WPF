<Page x:Class="Pr_WPF.Tovari"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr_WPF"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Tovari">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox x:Name="ProductsListBox" Grid.Row="0" SelectionMode="Single">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Image Source="{Binding ImagePath}" 
                                   Grid.Column="0"
                                   Width="150" 
                                   Height="150"
                                   Margin="0,0,20,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" 
                                           FontSize="24" 
                                           FontWeight="Bold"
                                           Margin="0,0,0,10"/>

                                <TextBlock Text="{Binding Price, StringFormat='Цена: {0} з.с.'}" 
                                           FontSize="18"
                                           Foreground="Green"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="1" Background="LightGray" Padding="10">
            <Button x:Name="AddToCartButton"
                    Content="Добавить товар в корзину"
                    Width="225"
                    Height="40"
                    FontSize="16"
                    Click="AddToCart_Click"
                    IsEnabled="False"/>
        </Border>
    </Grid>
</Page>
