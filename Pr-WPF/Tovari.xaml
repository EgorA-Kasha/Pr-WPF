<Page x:Class="Pr_WPF.Tovari"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr_WPF"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Tovari">

    <Grid>

        <ListBox x:Name="ProductsListBox">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray" BorderThickness="1" Margin="10" Padding="10" Width="732">
                        <StackPanel Orientation="Vertical">
                            <Image Width="100" Height="100">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Id}" Value="1">
                                                <Setter Property="Source" Value="Images/Шаурма.jpg"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Id}" Value="2">
                                                <Setter Property="Source" Value="Images/Кола.jpg"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Id}" Value="3">
                                                <Setter Property="Source" Value="Images/Телец.jpg"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>

                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,5" TextAlignment="Center"/>
                            <TextBlock Text="{Binding Price, StringFormat='Цена: {0} з.с.'}" Margin="0,5" TextAlignment="Center"/>

                            <Button Content="Добавить в корзину" Width="120" Margin="0,5" Click="AddToCart_Click"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
