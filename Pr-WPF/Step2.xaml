<UserControl x:Class="CarConfigurator.Step2Page"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <StackPanel Margin="20">
        <TextBlock Text="*Выберите цвет кузова" 
                   FontSize="16" FontWeight="SemiBold" 
                   Margin="0,0,0,10"/>

        <ComboBox x:Name="colorCombo"
                  FontSize="14" Padding="10,5"
                  Margin="0,5,0,15" MinWidth="200"/>

        <TextBlock Text="Дополнительные опции" 
                   FontSize="16" FontWeight="SemiBold" 
                   Margin="0,20,0,10"/>

        <ScrollViewer Height="200" Margin="0,10,0,20">
            <StackPanel>
                <CheckBox x:Name="leatherInteriorCheck"
                          FontSize="14" Margin="0,5,0,5"
                          Content="Кожаный салон (+100,000 руб.)"/>

                <CheckBox x:Name="panoramicRoofCheck"
                          FontSize="14" Margin="0,5,0,5"
                          Content="Панорамная крыша (+150,000 руб.)"/>

                <CheckBox x:Name="heatedSeatsCheck"
                          FontSize="14" Margin="0,5,0,5"
                          Content="Подогрев сидений (+50,000 руб.)"/>

                <CheckBox x:Name="rearCameraCheck"
                          FontSize="14" Margin="0,5,0,5"
                          Content="Камера заднего вида (+40,000 руб.)"/>

                <CheckBox x:Name="parkingSensorsCheck"
                          FontSize="14" Margin="0,5,0,5"
                          Content="Парктроник (+30,000 руб.)"/>

                <CheckBox x:Name="cruiseControlCheck"
                          FontSize="14" Margin="0,5,0,5"
                          Content="Круиз-контроль (+60,000 руб.)"/>

                <CheckBox x:Name="climateControlCheck"
                          FontSize="14" Margin="0,5,0,5"
                          Content="Климат-контроль (+80,000 руб.)"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel>
            <TextBlock Text="Итоговая стоимость:" 
                       FontSize="14" Margin="0,10,0,5"/>

            <TextBlock x:Name="totalPriceText"
                       FontSize="20" FontWeight="Bold"
                       Foreground="DarkGreen" Margin="0,5"/>
        </StackPanel>
    </StackPanel>
</UserControl>