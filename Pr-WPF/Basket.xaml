<Page x:Class="Pr_WPF.Basket"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr_WPF"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Basket">

    <StackPanel Margin="20">
        <TextBlock Text="Корзина покупок" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Margin="0,0,0,20"/>

        <!-- Grid для табличного отображения -->
        <Grid x:Name="CartGrid" Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок таблицы -->
            <TextBlock Grid.Row="0" 
                       Text="Товары в заказе:" 
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <!-- Список товаров -->
            <ItemsControl Grid.Row="1" x:Name="CartItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                            <TextBlock Text="{Binding Product.Name}" Width="150"/>
                            <TextBlock Text=" x " Margin="5,0"/>
                            <TextBlock Text="{Binding Quantity}" Width="30"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <TextBlock x:Name="TotalPriceText" 
                   FontSize="18" 
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <Button Content="Оформить заказ" 
                Width="200" 
                Height="40" 
                Click="OrderButton_Click"/>
    </StackPanel>
</Page>
