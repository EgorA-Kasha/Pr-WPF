<Page x:Class="Pr_WPF.Pages.ManagerOrderDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ManagerOrderDetailsPage">

    <Grid Background="White">
        <StackPanel Margin="20" HorizontalAlignment="Left">
            <Button Content="Назад" Click="Back_Click" Padding="10,5" Margin="0,0,0,20" HorizontalAlignment="Left"/>

            <TextBlock Text="Детали заказа" FontWeight="Bold" FontSize="18" Margin="0,0,0,15"/>

            <TextBlock x:Name="TxtOrderId" FontSize="14" Margin="0,5" FontWeight="Bold"/>
            <TextBlock x:Name="TxtClient" FontSize="14" Margin="0,5"/>
            <TextBlock x:Name="TxtDates" FontSize="14" Margin="0,5"/>
            <TextBlock x:Name="TxtStatus" FontSize="14" Margin="0,15,0,5"/>

            <TextBlock Text="Список товаров в заказе:" FontWeight="Bold" Margin="0,10,0,5"/>

            <DataGrid x:Name="GridProducts" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="300" Margin="0,0,0,15">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Название товара" Binding="{Binding Product.Name}"/>
                    <DataGridTextColumn Header="Цена за шт." Binding="{Binding Product.Price}"/>
                    <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}"/>
                </DataGrid.Columns>
            </DataGrid>

            <Button x:Name="BtnIssue" Content="Выдать заказ" Click="IssueOrder_Click" Padding="10" HorizontalAlignment="Left"/>
        </StackPanel>
    </Grid>
</Page>
