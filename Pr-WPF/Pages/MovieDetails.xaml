<Page x:Class="Pr_WPF.Pages.MovieDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MovieDetails">

    <Grid>
        <StackPanel Orientation="Vertical">
            <ListBox ScrollViewer.HorizontalScrollBarVisibility="Disabled" x:Name="lb_movie">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Image Source="{Binding cover_art_path}" Width="100" Height="100" />
                            <TextBlock Margin="3" Text="{Binding title}"/>
                            <TextBlock Margin="3" Text="{Binding descr}"/>
                            <TextBlock Margin="3" Text="{Binding rating}"/>
                            <TextBlock Margin="3" Text="{Binding genres}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ListBox ScrollViewer.HorizontalScrollBarVisibility="Disabled" x:Name="lb_screenings" MinHeight="200">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Margin="3" Text="{Binding sc.datetime}"/>
                            <TextBlock Margin="3" Text="{Binding room.id}"/>
                            <TextBlock Margin="3" Text="{Binding room.rating}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button x:Name="b_next_next" Content="Далее" Width="200" Height="20" Click="b_next_next_Click"/>
        </StackPanel>
    </Grid>
</Page>
