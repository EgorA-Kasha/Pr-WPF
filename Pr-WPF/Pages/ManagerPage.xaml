<Page x:Class="Pr_WPF.Pages.ManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ManagerPage">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="10">
            <Button Content="Назад" Click="Back_Click" Padding="10,5" DockPanel.Dock="Left"/>
            <Button Content="Выйти" Click="Logout_Click" Padding="10,5" Margin="10,0,10,0" DockPanel.Dock="Left"/>
            <Button Content="Сохранить изменения" Click="Save_Click" Padding="10,5" DockPanel.Dock="Right"/>
        </DockPanel>

        <TabControl Grid.Row="1" Margin="10">
            <TabItem Header="Записи">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" x:Name="GridBookings" AutoGenerateColumns="False" CanUserAddRows="False" PreviewKeyDown="GridBookings_PreviewKeyDown" Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ID}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Дата/Время" Binding="{Binding DateTime}"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}"/>
                            <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <GroupBox Grid.Row="1" Header="Создание новой записи">
                        <StackPanel>
                            <WrapPanel Margin="5">
                                <TextBlock Text="Поиск клиента:" VerticalAlignment="Center" Margin="5"/>
                                <TextBox x:Name="TxtClientSearch" Width="150" Margin="5" Padding="2" ToolTip="Имя или телефон"/>
                                <Button Content="Найти" Click="SearchClient_Click" Margin="5" Padding="10,2"/>

                                <TextBlock Text="Выбранный клиент:" VerticalAlignment="Center" Margin="15,5,5,5"/>
                                <ComboBox x:Name="ComboClients" Width="200" Margin="5" DisplayMemberPath="FullName"/>
                            </WrapPanel>

                            <WrapPanel Margin="5">
                                <TextBlock Text="Услуга:" VerticalAlignment="Center" Margin="5"/>
                                <ComboBox x:Name="ComboServices" Width="150" Margin="5" DisplayMemberPath="Name" SelectionChanged="ComboServices_SelectionChanged"/>

                                <TextBlock Text="Мастер:" VerticalAlignment="Center" Margin="5"/>
                                <ComboBox x:Name="ComboMasters" Width="150" Margin="5" DisplayMemberPath="FullName"/>

                                <TextBlock Text="Дата:" VerticalAlignment="Center" Margin="5"/>
                                <DatePicker x:Name="PickerDate" Margin="5"/>

                                <TextBlock Text="Время:" VerticalAlignment="Center" Margin="5"/>
                                <ComboBox x:Name="ComboTime" Margin="5">
                                    <ComboBoxItem Content="10:00"/>
                                    <ComboBoxItem Content="12:00"/>
                                    <ComboBoxItem Content="14:00"/>
                                    <ComboBoxItem Content="16:00"/>
                                    <ComboBoxItem Content="18:00"/>
                                </ComboBox>
                            </WrapPanel>

                            <WrapPanel Margin="5">
                                <TextBlock Text="Способ оплаты:" VerticalAlignment="Center" Margin="5"/>
                                <ComboBox x:Name="ComboPayment" Margin="5">
                                    <ComboBoxItem Content="Наличные"/>
                                    <ComboBoxItem Content="Карта"/>
                                </ComboBox>

                                <TextBlock Text="Комментарий:" VerticalAlignment="Center" Margin="5"/>
                                <TextBox x:Name="TxtComment" Width="200" Margin="5" Padding="2"/>

                                <Button Content="Добавить запись" Click="AddBooking_Click" Margin="20,5,5,5" Padding="10,5"/>
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Заказы">
                <DataGrid x:Name="GridOrders" AutoGenerateColumns="False" CanUserAddRows="False" MouseDoubleClick="GridOrders_DoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding ID}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Дата заказа" Binding="{Binding OrderDate}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Дата выдачи" Binding="{Binding ReceiveDate}"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Товары">
                <DataGrid x:Name="GridProducts" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название" Binding="{Binding Name}"/>
                        <DataGridTextColumn Header="Цена" Binding="{Binding Price}"/>
                        <DataGridTextColumn Header="Скидка" Binding="{Binding Discount}"/>
                        <DataGridCheckBoxColumn Header="Заморожен" Binding="{Binding IsFrozen}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            
            <TabItem Header="Производители">
                <DataGrid x:Name="GridManufacturers" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Имя производителя" Binding="{Binding Name}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Услуги">
                <DataGrid x:Name="GridServices" AutoGenerateColumns="True"/>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
