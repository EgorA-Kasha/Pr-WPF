<Page x:Class="Pr_WPF.Pages.StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="StartPage">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="НАЗВАНИЕ ИГРЫ" FontSize="48" FontWeight="Bold" Margin="0,0,0,50" HorizontalAlignment="Center"/>
            <Button x:Name="BtnStart" Content="Начать игру" FontSize="24" Padding="20,10" Click="BtnStart_Click"/>
        </StackPanel>
    </Grid>
</Page>
