<Page x:Class="Pr_WPF.Pages.CompletedBuilds"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CompletedBuilds">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#2C3E50" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <TextBlock Text="Сохраненные сборки" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Border>

        <!-- Список сборок -->
        <ListView x:Name="lvAssemblies" Grid.Row="1" SelectionMode="Single" 
                  MouseDoubleClick="lvAssemblies_MouseDoubleClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10" Margin="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Author}" Foreground="Gray"/>
                                <TextBlock Text="{Binding PartsCount, StringFormat={}Деталей: {0}}" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding TotalPrice, StringFormat={}Общая цена: {0:C}}" 
                                           Foreground="Green" FontWeight="Bold"/>
                            </StackPanel>

                            <Button Grid.Column="1" Content="Загрузить" 
                                    Tag="{Binding Id}" Click="LoadAssembly_Click"
                                    Background="#3498DB" Foreground="White" 
                                    BorderThickness="0" Padding="10,5" Margin="5"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
