<Page x:Class="Pr_WPF.Pages.MasterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MasterPage">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="10">
            <Button Content="Назад" Click="Back_Click" Padding="10,5" DockPanel.Dock="Left"/>
            <Button Content="Выйти" Click="Logout_Click" Padding="10,5" Margin="10,0,0,0" DockPanel.Dock="Left"/>
        </DockPanel>

        <TabControl Grid.Row="1" Margin="10">
            <TabItem Header="Записи ко мне">
                <DataGrid x:Name="GridBookings" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="GridBookings_DoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding OriginalBooking.ID}"/>
                        <DataGridTextColumn Header="Дата и время" Binding="{Binding OriginalBooking.DateTime}"/>
                        <DataGridTextColumn Header="Услуга" Binding="{Binding ServiceName}"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding OriginalBooking.Status}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Мои услуги">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox x:Name="ListServices" Grid.Row="0" Margin="5">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="5"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="1" Content="Сохранить изменения услуг" Click="SaveServices_Click" Padding="10" Margin="5,10,5,5"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
