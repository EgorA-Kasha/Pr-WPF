<Page x:Class="Pr_WPF.Pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="800"
      Title="UserPage">

    <Grid>
        <StackPanel Orientation="Vertical">
            <TextBlock x:Name="tb_userdata" Width="300" Height="200" Margin="0 150 0 -100"/>
            <ListBox ScrollViewer.HorizontalScrollBarVisibility="Disabled" x:Name="lb_tickets" Margin="0 -80 0 0">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Margin="3" Text="{Binding movie.title}"/>
                            <TextBlock Margin="3" Text="{Binding screening.datetime}"/>
                            <TextBlock Margin="3" Text="{Binding screening.room}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Grid>
</Page>
