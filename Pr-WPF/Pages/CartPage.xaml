<Page x:Class="Pr_WPF.Pages.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CartPage">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Content="Назад" Click="Back_Click" HorizontalAlignment="Left" Margin="10" Padding="10,5"/>

        <ScrollViewer Grid.Row="1" Margin="10">
            <ItemsControl x:Name="ListCart">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="250" Margin="10" BorderBrush="Gray" BorderThickness="1" Padding="10">
                            <StackPanel>
                                <TextBlock Text="{Binding Key.Name}" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Key.Price, StringFormat=Цена: {0}}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10">
                                    <Button Content="-" Click="Minus_Click" Tag="{Binding Key}" Width="30"/>
                                    <TextBlock Text="{Binding Value}" VerticalAlignment="Center" Margin="10,0"/>
                                    <Button Content="+" Click="Plus_Click" Tag="{Binding Key}" Width="30"/>
                                </StackPanel>
                                <Button Content="Удалить" Click="Remove_Click" Tag="{Binding Key}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="10" Background="WhiteSmoke">
            <TextBlock Text="Оформление заказа" FontWeight="Bold"/>
            <TextBlock Text="Выберите дату получения (не более 7 дней):"/>
            <DatePicker x:Name="PickerDate" Margin="0,5"/>
            <TextBlock Text="Способ оплаты:"/>
            <ComboBox x:Name="ComboPayment" Margin="0,5">
                <ComboBoxItem Content="Наличные"/>
                <ComboBoxItem Content="Карта"/>
            </ComboBox>
            <Button Content="Оформить заказ" Click="Order_Click" Padding="10" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Page>
