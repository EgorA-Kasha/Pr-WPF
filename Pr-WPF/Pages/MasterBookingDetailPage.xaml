<Page x:Class="Pr_WPF.Pages.MasterBookingDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MasterBookingDetailPage">

    <Grid>
        <StackPanel Margin="20" HorizontalAlignment="Left">
            <Button Content="Назад" Click="Back_Click" Padding="10,5" Margin="0,0,0,20" HorizontalAlignment="Left"/>

            <TextBlock Text="Подробности записи" FontWeight="Bold" FontSize="18" Margin="0,0,0,15"/>

            <TextBlock x:Name="TxtDateTime" FontSize="14" Margin="0,5"/>
            <TextBlock x:Name="TxtClientName" FontSize="14" Margin="0,5"/>
            <TextBlock x:Name="TxtClientPhone" FontSize="14" Margin="0,5"/>
            <TextBlock x:Name="TxtService" FontSize="14" Margin="0,5"/>
            <TextBlock x:Name="TxtStatus" FontSize="14" Margin="0,5"/>
            <TextBlock x:Name="TxtComment" FontSize="14" Margin="0,5" TextWrapping="Wrap" MaxWidth="400"/>

            <Button x:Name="BtnComplete" Content="Завершить запись" Click="Complete_Click" Padding="10" Margin="0,20,0,0" HorizontalAlignment="Left"/>
        </StackPanel>
    </Grid>
</Page>
