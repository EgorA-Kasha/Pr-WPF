<Page x:Class="Pr_WPF.Pages.ScreeningDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ScreeningDetails">

    <Grid>
        <StackPanel Orientation="Vertical">
            <TextBlock Text="Убрать занятые места" Width="100" />
            <CheckBox x:Name="cb_hide_taken" Click="cb_hide_taken_Checked"/>
            <ListBox ScrollViewer.HorizontalScrollBarVisibility="Disabled" x:Name="lb_seats" SelectionChanged="lb_seats_SelectionChanged" Width="400">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </StackPanel>
    </Grid>
</Page>
