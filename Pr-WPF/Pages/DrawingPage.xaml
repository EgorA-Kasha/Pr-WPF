<Page x:Class="Pr_WPF.DrawingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr_WPF"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="600"
      Title="DrawingPage">

    <Grid>
        <StackPanel Orientation="Vertical">
            <Button></Button>
            <Canvas Width="500" Height="350" Background="AliceBlue" x:Name="DrowingCanvas" MouseDown="DrawingCanvas_MouseDown" MouseMove="DrawingCanvas_MouseMove" MouseUp="DrawingCanvas_MouseUp" Margin="0,0,0,72"/>
            <StackPanel.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Очистить фсё"/>
                    <MenuItem Header="На главную"/>
                </ContextMenu>
            </StackPanel.ContextMenu>
        </StackPanel>
    </Grid>
</Page>
