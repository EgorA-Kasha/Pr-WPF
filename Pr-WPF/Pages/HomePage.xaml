<Page x:Class="Pr_WPF.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="HomePage">

    <Grid>
        <StackPanel Orientation="Vertical">
            <Button x:Name="button_to_logreg" Width="135" Height="34" Content="Регистрация/Вход" Margin="50 50 50 50" Click="button_to_logreg_Click"/>
            <Button x:Name="button_to_movies" Width="135" Height="34" Content="К показам" Click="button_to_movies_Click" />
            <Button x:Name="button_to_userpage" Width="135" Height="34" Content="Профиль" Click="button_to_userpage_Click"/>
        </StackPanel>
    </Grid>
</Page>
