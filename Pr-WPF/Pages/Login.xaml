<Page x:Class="Pr_WPF.Pages.Login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Login">

    <Grid>
        <StackPanel Orientation="Vertical" Height="427" VerticalAlignment="Top" Margin="0 23 0 0">
            <TextBlock Text="Логин" Margin="200 0 0 0"/>
            <TextBox x:Name="tb_login" Height="20" Width="400"/>
            <TextBlock Text="Пароль" Margin="200 0 0 0"/>
            <TextBox x:Name="tb_passwd" Height="20" Width="400"/>
            <Button x:Name="button_log_reg" Width="228" Height="20" Margin="20 20 20 20" Content="Лес гоу!" Click="button_log_reg_Click"/>
        </StackPanel>
    </Grid>
</Page>
