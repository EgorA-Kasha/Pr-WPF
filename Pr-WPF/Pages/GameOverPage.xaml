<Page x:Class="Pr_WPF.Pages.GameOverPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GameOverPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="250"/>
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="0">
            <TextBlock Text="ВЫ ПРОИГРАЛИ" FontSize="48" FontWeight="Bold" Foreground="Red" Margin="0,0,0,50" HorizontalAlignment="Center"/>
            <Button x:Name="BtnRestart" Content="Начать заново" FontSize="24" Padding="20,10" Click="BtnRestart_Click"/>
        </StackPanel>

        <Border BorderBrush="Black" BorderThickness="0,3,0,0" Grid.Row="1" Background="White">
            <Grid>
                <TextBlock Text="ЛОхГ" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,5,0,0" FontSize="16"/>
                <ScrollViewer x:Name="LogScroll" Margin="10,35,10,10" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TxtFinalLog" TextWrapping="Wrap" FontSize="14"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
