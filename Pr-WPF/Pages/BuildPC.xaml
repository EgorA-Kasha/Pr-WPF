<Page x:Class="Pr_WPF.Pages.BuildPC"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="BuildPC">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <!-- Левая колонка - выбор комплектующих -->
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Поиск и фильтры -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBox x:Name="txtSearch" TextChanged="txtSearch_TextChanged" 
                         Height="35" Padding="10" FontSize="14" 
                         VerticalAlignment="Center" Margin="0,0,0,5"/>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Производитель:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="cmbManufacturer" Width="150" Height="30" 
                              SelectionChanged="cmbManufacturer_SelectionChanged"/>
                </StackPanel>
            </StackPanel>

            <!-- Типы комплектующих с кнопками -->
            <ScrollViewer Grid.Row="1" MaxHeight="150" Margin="0,0,0,10">
                <WrapPanel>
                    <Button Content="CPU" Tag="1" Click="PartType_Click" 
                            Width="80" Height="40" Margin="2" Style="{StaticResource PartTypeButton}"/>
                    <Button Content="GPU" Tag="2" Click="PartType_Click" 
                            Width="80" Height="40" Margin="2" Style="{StaticResource PartTypeButton}"/>
                    <Button Content="RAM" Tag="3" Click="PartType_Click" 
                            Width="80" Height="40" Margin="2" Style="{StaticResource PartTypeButton}"/>
                    <Button Content="Материнская плата" Tag="4" Click="PartType_Click" 
                            Width="120" Height="40" Margin="2" Style="{StaticResource PartTypeButton}"/>
                    <Button Content="Корпус" Tag="5" Click="PartType_Click" 
                            Width="80" Height="40" Margin="2" Style="{StaticResource PartTypeButton}"/>
                    <Button Content="Блок питания" Tag="6" Click="PartType_Click" 
                            Width="100" Height="40" Margin="2" Style="{StaticResource PartTypeButton}"/>
                    <Button Content="Кулер" Tag="7" Click="PartType_Click" 
                            Width="80" Height="40" Margin="2" Style="{StaticResource PartTypeButton}"/>
                    <Button Content="Накопитель" Tag="8" Click="PartType_Click" 
                            Width="100" Height="40" Margin="2" Style="{StaticResource PartTypeButton}"/>
                </WrapPanel>
            </ScrollViewer>

            <!-- Список комплектующих -->
            <ListView x:Name="lvParts" Grid.Row="2" 
                      SelectionMode="Single" MouseDoubleClick="lvParts_MouseDoubleClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="5" Margin="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Image Source="{Binding Image}" Width="50" Height="50" Grid.Column="0" Margin="0,0,10,0"/>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding ManufacturerName}" Foreground="Gray"/>
                                    <TextBlock Text="{Binding Price, StringFormat={}Цена: {0:C}}" Foreground="Green"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Разделитель -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" 
                      VerticalAlignment="Stretch" Background="Gray"/>

        <!-- Правая колонка - выбранные комплектующие и цена -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Grid.Row="0" Background="#2C3E50" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                <TextBlock Text="Ваша сборка" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
            </Border>

            <!-- Список выбранных комплектующих -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="icSelectedParts">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#BDC3C7" BorderThickness="0,0,0,1" Padding="5" Margin="0,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" 
                                               FontWeight="Bold" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Characteristics}" 
                                               Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Price, StringFormat={}{0:C}}" 
                                               Foreground="Green" Margin="10,0"/>
                                    <Button Grid.Row="1" Grid.Column="1" Content="Удалить" 
                                            Tag="{Binding Id}" Click="RemovePart_Click"
                                            Background="#E74C3C" Foreground="White" 
                                            BorderThickness="0" Padding="5" Margin="5,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Итого -->
            <Border Grid.Row="2" Background="#27AE60" CornerRadius="5" Padding="15" Margin="0,10">
                <StackPanel>
                    <TextBlock Text="ИТОГО:" Foreground="White" FontSize="16" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="txtTotalPrice" Text="0 ₽" Foreground="White" 
                               FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Кнопка сохранения -->
            <StackPanel Grid.Row="3">
                <TextBox x:Name="txtAssemblyName" Height="30" Margin="0,0,0,5" 
                         Padding="5" Text="Название сборки"/>
                <TextBox x:Name="txtAuthor" Height="30" Margin="0,0,0,5" 
                         Padding="5" Text="Автор"/>
                <Button x:Name="btnSaveAssembly" Content="Сохранить сборку" 
                        Height="40" Background="#3498DB" Foreground="White" 
                        FontSize="14" FontWeight="Bold" BorderThickness="0" 
                        Click="btnSaveAssembly_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
