<UserControl x:Class="CarConfigurator.Step4Page"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" x:Name="mainPanel">
            <TextBlock Text="Расчёт параметров кредита" 
                       FontSize="16" FontWeight="SemiBold" 
                       Margin="0,0,0,10"/>

            <TextBlock Text="Стоимость автомобиля:"
                       FontSize="14" Margin="0,20,0,5"/>

            <TextBlock x:Name="totalPriceText"
                       FontSize="18" FontWeight="Bold"
                       Foreground="DarkGreen" Margin="0,5"/>

            <!-- Первоначальный взнос -->
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="Первоначальный взнос (%)"
                           FontSize="14" Margin="0,10,0,5"/>

                <Slider x:Name="downPaymentSlider"
                        Minimum="10" Maximum="90"
                        TickFrequency="5" IsSnapToTickEnabled="True"
                        Margin="0,0,0,5"/>

                <TextBlock x:Name="downPaymentValue"
                           HorizontalAlignment="Center" FontSize="14"/>
            </StackPanel>

            <!-- Срок кредита -->
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="Срок кредита (месяцев)"
                           FontSize="14" Margin="0,10,0,5"/>

                <Slider x:Name="termSlider"
                        Minimum="12" Maximum="96"
                        TickFrequency="12" IsSnapToTickEnabled="True"
                        Margin="0,0,0,5"/>

                <TextBlock x:Name="termValue"
                           HorizontalAlignment="Center" FontSize="14"/>
            </StackPanel>

            <!-- Расчет платежей -->
            <Border x:Name="calculationPanel" 
                    Background="WhiteSmoke" Padding="15" 
                    Margin="0,30,0,0">
                <StackPanel/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>